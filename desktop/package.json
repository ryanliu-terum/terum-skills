{
  "name": "terum-skills-desktop",
  "private": true,
  "version": "0.1.9",
  "description": "terum-skills desktop frontend (Vite + React, mock backend, pixel-faithful to the design boards)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryanliu-terum/terum-skills.git",
    "directory": "desktop"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "export": "python3 tools/export-design.py",
    "export:check": "python3 tools/export-design.py --check",
    "e2e:routes": "playwright test e2e/routes",
    "e2e:fidelity": "playwright test e2e/fidelity",
    "check": "npm run typecheck && npm run lint && npm run test && npm run e2e:routes",
    "check:design": "npm run export:check && npm run e2e:fidelity",
    "tauri": "tauri"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@tanstack/react-query": "5.102.8",
    "clsx": "2.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "react-router": "8.3.1",
    "remark-gfm": "4.0.1",
    "zod": "4.5.4",
    "zustand": "5.0.15",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "@tauri-apps/plugin-store": "^2.4.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "globals": "17.12.0",
    "jsdom": "30.0.1",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "@tauri-apps/cli": "^2.11.4"
  }
}
