{
  "permissions": {
    "allow": [
      "Bash(codex exec:*)",
      "Bash(codex login status:*)",
      "Bash(codex --version:*)",
      "WebSearch",
      "Bash(npm run:*)",
      "Bash(npm ci *)",
      "Bash(npm install:*)",
      "Bash(npm test *)",
      "Bash(npx tsc:*)",
      "Bash(npx vitest *)",
      "Bash(node *)",
      "Bash(git *)",
      "Bash(gh pr *)",
      "Bash(gh repo *)",
      "Bash(gh api *)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)"
    ],
    "deny": [
      "Bash(codex exec --dangerously-bypass-approvals-and-sandbox:*)",
      "Read(.env*)",
      "Read(*.pem)",
      "Read(*.key)",
      "Read(*.p12)",
      "Read(*.pfx)",
      "Read(*.p8)",
      "Read(*service-account*.json)",
      "Read(*credentials*.json)",
      "Read(.git/config)",
      "Bash(cat .env*)",
      "Bash(type .env*)",
      "Read(~/.ssh/*)",
      "Read(~/.aws/credentials)",
      "Read(~/.aws/config)",
      "Read(~/.npmrc)",
      "Read(~/.gitconfig)",
      "Read(~/.config/gh/hosts.yml)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node .claude/hooks/statusline.js"
  },
  "skillOverrides": {
    "diagnose": "off",
    "tdd": "off"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/capture.js\" upload",
            "timeout": 60
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/intent-check-reminder.js\"",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/capture.js\" delivery-hook prompt",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/typecheck-on-edit.js\"",
            "timeout": 90,
            "async": true
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/handoff-resume-marker.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/no-verify-guard.js\"",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "code-simplifier@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true
  }
}
