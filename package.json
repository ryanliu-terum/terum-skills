{
  "name": "terum-skills",
  "version": "0.12.1",
  "description": "Share private Claude Code skills across a team through one private git repo. No server.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryanliu-terum/terum-skills.git"
  },
  "bugs": {
    "url": "https://github.com/ryanliu-terum/terum-skills/issues"
  },
  "homepage": "https://github.com/ryanliu-terum/terum-skills#readme",
  "keywords": [
    "claude-code",
    "skills",
    "team",
    "git"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "terum-skills": "./dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/bundle-cli.mjs && node scripts/bundle-skill.mjs",
    "prepack": "npm run build",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "proper-lockfile": "^4.1.2",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/proper-lockfile": "^4.1.4",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
